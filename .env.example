# Copy to .env.local and fill in. Never commit .env.local.

# ── App ──────────────────────────────────────────────
# Public base URL (Vercel URL in production). Sarvam tools and webhooks call this.
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Shared secret for Sarvam tool calls, NudgeBee HTTP steps and internal webhooks.
RAKTFLOW_API_KEY=generate-with-openssl-rand-hex-24

# ── Neon Postgres ────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/raktflow?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/raktflow?sslmode=require

# ── Flagsmith ────────────────────────────────────────
# Server-side environment key (starts with "ser."), Environment Settings → SDK Keys
FLAGSMITH_SERVER_KEY=
# Organisation API key, Organisation Settings → API Keys (Management API)
FLAGSMITH_ADMIN_API_KEY=
FLAGSMITH_PROJECT_ID=
# The environment's key/ID shown in Environment Settings (used in Management API paths)
FLAGSMITH_ENVIRONMENT_KEY=
# Signing secret for the audit-log webhook (Organisation Settings → Webhooks)
FLAGSMITH_WEBHOOK_SECRET=
FLAGSMITH_REFRESH_SECONDS=30

# ── Sarvam ───────────────────────────────────────────
# Model APIs (api.sarvam.ai), header api-subscription-key
SARVAM_API_KEY=
# Voice Agents (apps.sarvam.ai), header X-API-Key
SARVAM_VOICE_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=

# ── NudgeBee ─────────────────────────────────────────
NUDGEBEE_API_TOKEN=
# Webhook trigger URL of the "Blood shortage" workflow
NUDGEBEE_SHORTAGE_WEBHOOK_URL=
# Webhook trigger URL of the "Voice worker rate-limited" workflow
NUDGEBEE_RATELIMIT_WEBHOOK_URL=

# ── Demo ─────────────────────────────────────────────
# The one real number we dial (a teammate who agreed to the demo call), E.164
DEMO_DONOR_PHONE=
DEMO_DONOR_NAME=Ravi
